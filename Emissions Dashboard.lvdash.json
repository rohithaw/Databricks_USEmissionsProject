{
  "datasets": [
    {
      "name": "ed3d796a",
      "displayName": "Location Data",
      "queryLines": [
        "select latitude,longitude,`GHG emissions mtons CO2e` as Emissions from emissions_data"
      ],
      "catalog": "emission_data",
      "schema": "default"
    },
    {
      "name": "7902dac9",
      "displayName": "Emissions per person",
      "queryLines": [
        "SELECT\n",
        "  county_state_name,\n",
        "  population,\n",
        "  TRY_CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) / NULLIF(population, 0) AS emissions_per_person\n",
        "FROM emissions_data\n",
        "WHERE population > 0\n",
        "  AND TRY_CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) IS NOT NULL\n",
        "  AND TRY_CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) > 0\n",
        "ORDER BY emissions_per_person DESC"
      ],
      "columns": [
        {
          "displayName": "total_emissions",
          "description": "Total GHG emissions (mtons CO2e) per county, derived from per-person rate × population",
          "expression": "emissions_per_person * population"
        },
        {
          "displayName": "weighted_avg_epp",
          "description": "Population-weighted average GHG emissions per person across all counties",
          "expression": "SUM(total_emissions) / NULLIF(SUM(population), 0)"
        }
      ],
      "catalog": "emission_data",
      "schema": "default"
    },
    {
      "name": "655c1d33",
      "displayName": "Total Emissions Per State",
      "queryLines": [
        "SELECT\n",
        "  state_abbr,\n",
        "  SUM(TRY_CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE)) AS Total_Emissions\n",
        "FROM emissions_data\n",
        "GROUP BY state_abbr\n",
        "ORDER BY Total_Emissions DESC LIMIT 10"
      ],
      "catalog": "emission_data",
      "schema": "default"
    },
    {
      "name": "fa545a01",
      "displayName": "Top Ten Counties by Carbon Emission and Population Data",
      "queryLines": [
        "SELECT\n",
        "  county_state_name,\n",
        "  population,\n",
        "  TRY_CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) as Total_emissions\n",
        "FROM emissions_data\n",
        "ORDER BY Total_emissions DESC limit 10"
      ],
      "columns": [
        {
          "displayName": "emissions_per_person",
          "description": "GHG emissions per person (metric tons CO2e per capita) for each county",
          "expression": "Total_emissions / NULLIF(population, 0)"
        }
      ],
      "catalog": "emission_data",
      "schema": "default"
    }
  ],
